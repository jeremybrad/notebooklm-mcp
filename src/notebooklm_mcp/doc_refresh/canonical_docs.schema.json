{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c021.canonical_docs.v1",
  "title": "C021 Canonical Docs Manifest v1",
  "description": "Schema for src/notebooklm_mcp/doc_refresh/canonical_docs.yaml. Defines which repository files qualify as NotebookLM documentation sources: tiered includes, privacy exclusions, per-repo overrides, and freshness metadata. Exclusion globs always win over includes (fail-closed). Paths that are absolute, escape the repo root, or symlink out of the repo are omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "last_updated",
    "tiers",
    "exclusions"
  ],
  "properties": {
    "schema": {
      "const": "c021.canonical_docs.v1",
      "description": "Closed schema identifier. Not a second registry."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Manifest document version (semver)."
    },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date the packaged manifest was last edited (UTC calendar date)."
    },
    "tier3_candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier1", "tier2", "tier3"],
      "properties": {
        "tier1": { "$ref": "#/$defs/tier" },
        "tier2": { "$ref": "#/$defs/tier" },
        "tier3": { "$ref": "#/$defs/tier" }
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "description": "Privacy/build globs omitted from discovery even when extra_docs includes them.",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "validation_rules": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/validation_rule" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "change_detection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_delta_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repo_overrides": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/repo_override" }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "documents"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "path_prefix": { "type": "string", "minLength": 1 },
        "documents": {
          "type": "array",
          "items": { "$ref": "#/$defs/document" }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "purpose"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path. Absolute, UNC, tilde, and parent-escape paths are refused at discovery."
        },
        "purpose": { "type": "string", "minLength": 1 },
        "must_exist": { "type": "boolean" },
        "stub_allowed": { "type": "boolean" },
        "is_directory": { "type": "boolean" },
        "scan_pattern": { "type": "string", "minLength": 1 },
        "alternate_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "validation": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "reason"],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Glob relative to repo root. Exclusion always wins over include/extra_docs."
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "validation_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "check"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "check": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tool"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "tool_params": { "type": "object" },
        "default_trigger": { "type": "string" }
      }
    },
    "repo_override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier3_root": { "type": "string", "minLength": 1 },
        "extra_docs": {
          "type": "array",
          "items": { "$ref": "#/$defs/document" }
        },
        "exclusions": {
          "type": "array",
          "items": { "$ref": "#/$defs/exclusion" }
        }
      }
    }
  }
}
